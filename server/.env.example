PORT=5000
MONGODB_URI=mongodb://localhost:27017/teamfinder
JWT_SECRET=your_secret_here
NODE_ENV=development

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# For Render Free Tier (HTTPS API - recommended, bypasses blocked SMTP ports)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER=your_email@gmail.com

# For Local Development (Direct SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="NBKRIST TeamFinder" <your_email@gmail.com>
